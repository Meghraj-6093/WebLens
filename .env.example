# WebLens Environment Configuration Template
# Copy to .env for local overrides

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_PATH=./weblens.db

# Scanner Configuration
SCAN_CONCURRENCY_LIMIT=3
SCAN_TIMEOUT_MS=30000

# Security & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_here_for_development
